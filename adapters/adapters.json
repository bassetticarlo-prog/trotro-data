        }
      ],
      "capabilities": {
        "atsh": "verified",
        "atcaf0": "ok_response",
        "uds_passthrough": "verified",
        "ecus_seen": [
          "7E8",
          "7E9"
        ],
        "latency_010c_ms": {
          "ble": "72-81",
          "classic": "50-100 (media 69)"
        }
      },
      "recommended": true,
      "tested": [
        {
          "date": "2026-11-13",
          "vehicle": "VW Tiguan Allspace 2019 2.0 TDI (DFG)",
