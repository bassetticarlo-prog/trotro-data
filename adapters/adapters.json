        },
        {
          "date": "2026-11-17",
          "vehicle": "VW Tiguan Allspace 2019 2.0 TDI (DFG)",
          "transport": "ble",
          "notes": "11 DID UDS letti (pacchetto vw-ea288)"
        },
        {
          "date": "2026-11-18",
          "vehicle": "VW Tiguan Allspace 2019 2.0 TDI (DFG)",
          "transport": "ble",
          "notes": "canale UART 18F0/2AF0/2AF1, latenza media 72 ms"
        },
        {
          "date": "2026-11-19",
          "vehicle": "VW Tiguan Allspace 2019 2.0 TDI (DFG)",
          "transport": "classic",
          "notes": "SPP RFCOMM sicuro al primo tentativo; 7E8 e 7E9, modo 09 e UDS 22 F190 come via BLE"
